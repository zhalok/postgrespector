{
  "title": "Postgres Metrics",
  "uid": "postgres-metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Buffer Cache Blocks Hit Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(pg_stat_database_blks_hit_total[1m])",
          "legendFormat": "blocks hit/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Buffer Cache Blocks Read Rate (disk)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(pg_stat_database_blks_read_total[1m])",
          "legendFormat": "blocks read/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Postgres Block Size",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "pg_block_size_bytes", "legendFormat": "block size" }
      ]
    },
    {
      "id": 4,
      "title": "Table Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "pg_table_size_bytes", "legendFormat": "{{table}}" }
      ]
    },
    {
      "id": 5,
      "title": "Index Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "pg_index_size_bytes", "legendFormat": "{{table}}" }
      ]
    },
    {
      "id": 6,
      "title": "Total Relation Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "pg_total_relation_size_bytes",
          "legendFormat": "{{table}} (table+index+toast)"
        }
      ]
    },
    {
      "id": 7,
      "title": "Query Avg Exec Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "expr": "pg_query_avg_exec_time_ms", "legendFormat": "avg exec time" }
      ]
    },
    {
      "id": 8,
      "title": "Query P90 Exec Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "expr": "pg_query_p90_exec_time_ms", "legendFormat": "p90 exec time" }
      ]
    },
    {
      "id": 9,
      "title": "Query Avg Plan Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "expr": "pg_query_avg_plan_time_ms", "legendFormat": "avg plan time" }
      ]
    },
    {
      "id": 10,
      "title": "Query P90 Plan Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "expr": "pg_query_p90_plan_time_ms", "legendFormat": "p90 plan time" }
      ]
    },
    {
      "id": 11,
      "title": "Average Buffer Usage",
      "description": "",
      "links": [],
      "data": {
        "kind": "QueryGroup",
        "spec": {
          "queries": [
            {
              "kind": "PanelQuery",
              "spec": {
                "query": {
                  "kind": "DataQuery",
                  "version": "v0",
                  "group": "prometheus",
                  "datasource": {
                    "name": "PBFA97CFB590B2093"
                  },
                  "spec": {
                    "editorMode": "code",
                    "expr": "sum(pg_query_avg_shared_blks_hit)",
                    "legendFormat": "avg blocks hit",
                    "range": true
                  }
                },
                "refId": "A",
                "hidden": true
              }
            },
            {
              "kind": "PanelQuery",
              "spec": {
                "query": {
                  "kind": "DataQuery",
                  "version": "v0",
                  "group": "prometheus",
                  "datasource": {
                    "name": "PBFA97CFB590B2093"
                  },
                  "spec": {
                    "editorMode": "code",
                    "expr": "sum(pg_query_avg_shared_blks_read)",
                    "legendFormat": "avg blocks read",
                    "range": true
                  }
                },
                "refId": "B",
                "hidden": true
              }
            },
            {
              "kind": "PanelQuery",
              "spec": {
                "query": {
                  "kind": "DataQuery",
                  "version": "v0",
                  "group": "prometheus",
                  "datasource": {
                    "name": "PBFA97CFB590B2093"
                  },
                  "spec": {
                    "editorMode": "code",
                    "expr": "sum(pg_block_size_bytes)",
                    "legendFormat": "block size bytes",
                    "range": true
                  }
                },
                "refId": "C",
                "hidden": true
              }
            },
            {
              "kind": "PanelQuery",
              "spec": {
                "query": {
                  "kind": "DataQuery",
                  "version": "v0",
                  "group": "__expr__",
                  "datasource": {
                    "name": "__expr__"
                  },
                  "spec": {
                    "expression": "($A + $B) * $C",
                    "type": "math"
                  }
                },
                "refId": "Average Buffer Usage",
                "hidden": false
              }
            }
          ],
          "transformations": [],
          "queryOptions": {}
        }
      },
      "vizConfig": {
        "kind": "VizConfig",
        "group": "timeseries",
        "version": "13.1.0",
        "spec": {
          "options": {
            "tooltip": {
              "mode": "single",
              "sort": "none",
              "hideZeros": false
            },
            "legend": {
              "showLegend": true,
              "displayMode": "list",
              "placement": "bottom",
              "overflow": "ellipsis",
              "calcs": [],
              "enableFacetedFilter": false
            },
            "annotations": {
              "multiLane": false,
              "clustering": -1
            }
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "barAlignment": 0,
                "barWidthFactor": 0.6,
                "lineWidth": 1,
                "fillOpacity": 0,
                "gradientMode": "none",
                "spanNulls": false,
                "insertNulls": false,
                "showPoints": "auto",
                "showValues": false,
                "pointSize": 5,
                "stacking": {
                  "mode": "none",
                  "group": "A"
                },
                "axisPlacement": "auto",
                "axisLabel": "",
                "axisColorMode": "text",
                "axisBorderShow": false,
                "scaleDistribution": {
                  "type": "linear"
                },
                "axisCenteredZero": false,
                "hideFrom": {
                  "tooltip": false,
                  "viz": false,
                  "legend": false
                },
                "thresholdsStyle": {
                  "mode": "off"
                }
              },
              "color": {
                "mode": "palette-classic"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "value": null,
                    "color": "green"
                  },
                  {
                    "value": 80,
                    "color": "red"
                  }
                ]
              },
              "unit": "bytes"
            },
            "overrides": []
          }
        }
      }
    },
     {
      "id": 12,
      "title": "Top 10 Slowest Queries",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "query", "mode": "outer" }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "field": "Value #B", "desc": true }]
          }
        },
        {
          "id": "limit",
          "options": { "limitField": 10 }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true,
              "queryid 2": true,
              "queryid 3": true,
              "queryid 4": true,
              "queryid 5": true,
              "queryid 6": true,
              "queryid 7": true,
              "queryid 8": true
            },
            "renameByName": {
              "queryid 1": "queryid",
              "Value #A": "calls",
              "Value #B": "mean exec time (ms)",
              "Value #C": "mean plan time (ms)",
              "Value #D": "rows",
              "Value #E": "shared blks hit",
              "Value #F": "shared blks read",
              "Value #G": "shared blks dirtied",
              "Value #H": "shared blks written"
            }
          }
        }
      ],
      "targets": [
        { "refId": "A", "expr": "pg_query_stats_calls", "format": "table", "instant": true },
        { "refId": "B", "expr": "pg_query_stats_mean_exec_time_ms", "format": "table", "instant": true },
        { "refId": "C", "expr": "pg_query_stats_mean_plan_time_ms", "format": "table", "instant": true },
        { "refId": "D", "expr": "pg_query_stats_rows", "format": "table", "instant": true },
        { "refId": "E", "expr": "pg_query_stats_shared_blks_hit", "format": "table", "instant": true },
        { "refId": "F", "expr": "pg_query_stats_shared_blks_read", "format": "table", "instant": true },
        { "refId": "G", "expr": "pg_query_stats_shared_blks_dirtied", "format": "table", "instant": true },
        { "refId": "H", "expr": "pg_query_stats_shared_blks_written", "format": "table", "instant": true }
      ]
    }
  ]
}
