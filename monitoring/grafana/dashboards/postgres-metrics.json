{
  "title": "Postgres Metrics",
  "uid": "postgres-metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Buffer Cache Blocks Hit Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "rate(pg_stat_database_blks_hit_total[1m])", "legendFormat": "blocks hit/s" }
      ]
    },
    {
      "id": 2,
      "title": "Buffer Cache Blocks Read Rate (disk)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "rate(pg_stat_database_blks_read_total[1m])", "legendFormat": "blocks read/s" }
      ]
    },
    {
      "id": 3,
      "title": "Postgres Block Size",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "pg_block_size_bytes", "legendFormat": "block size" }
      ]
    },
    {
      "id": 4,
      "title": "Orders Table Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "pg_table_size_bytes{table=\"orders\"}", "legendFormat": "orders table" }
      ]
    },
    {
      "id": 5,
      "title": "Orders Index Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "pg_index_size_bytes{table=\"orders\",index=\"all\"}", "legendFormat": "orders indexes" }
      ]
    },
    {
      "id": 6,
      "title": "Orders Total Relation Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "pg_total_relation_size_bytes{table=\"orders\"}", "legendFormat": "orders total (table+index+toast)" }
      ]
    },
    {
      "id": 7,
      "title": "Query Avg Exec Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "expr": "pg_query_avg_exec_time_ms", "legendFormat": "avg exec time" }
      ]
    },
    {
      "id": 8,
      "title": "Query P90 Exec Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "expr": "pg_query_p90_exec_time_ms", "legendFormat": "p90 exec time" }
      ]
    },
    {
      "id": 9,
      "title": "Query Avg Plan Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "expr": "pg_query_avg_plan_time_ms", "legendFormat": "avg plan time" }
      ]
    },
    {
      "id": 10,
      "title": "Query P90 Plan Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "expr": "pg_query_p90_plan_time_ms", "legendFormat": "p90 plan time" }
      ]
    }
  ]
}
